# Copy this file to `.env` and fill in what you need.
# With nothing set, the app runs on a local SQLite file (instance/campus_hub.db).

# Flask session signing key. Always set this in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# --- Database (optional) ---
# Either a full SQLAlchemy URL...
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smart_campus_service_hub?charset=utf8mb4
# ...or the individual MySQL settings:
# DB_USER=root
# DB_PASS=
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=smart_campus_service_hub

# --- Maps & routing (optional) ---
# Free key from https://openrouteservice.org/dev/#/signup
# Enables address geocoding and road routes on the ride-share map.
OPENROUTESERVICE_API_KEY=

# Set to 1 to run the dev server with the debugger and auto-reload
FLASK_DEBUG=0
